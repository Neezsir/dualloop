# Universal AI Providers:
# Supported: claude-cli | anthropic | agy | gemini-cli | gemini | codex-cli | openai | openrouter | ollama | custom
BACKEND_PROVIDER=claude-cli
BACKEND_MODEL=claude-opus-5-5

FRONTEND_PROVIDER=agy
FRONTEND_MODEL=gemini-4-hydrogen

# API Keys / Base URLs (fill only providers you use)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
CUSTOM_BASE_URL=
CUSTOM_API_KEY=

# Telegram 2-Way Control (optional for CLI-only mode, required for server daemon)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Runtime & Guardrails
WORKSPACES_DIR=~/Desktop
PUBLIC_HOST=
BASE_PORT=4100
MAX_FIX_LOOPS=4
MAX_AI_CALLS=20
ENABLE_CROSS_REVIEW=true
CLI_TIMEOUT_MS=180000
PONYTAIL_LEVEL=full
AUTO_FALLBACK=true
